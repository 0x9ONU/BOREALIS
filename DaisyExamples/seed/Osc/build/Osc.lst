  78:../../DaisySP/Source/Utility/dsp.h ****     l -= 0x3F800000;
  79:../../DaisySP/Source/Utility/dsp.h ****     l <<= (n - 1);
  80:../../DaisySP/Source/Utility/dsp.h ****     l += 0x3F800000;
  81:../../DaisySP/Source/Utility/dsp.h ****     *lp = l;
