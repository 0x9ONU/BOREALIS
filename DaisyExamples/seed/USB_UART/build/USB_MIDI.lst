   1:USB_MIDI.cpp  **** /** Example of setting reading MIDI Input via UART
   2:USB_MIDI.cpp  ****  *  
   3:USB_MIDI.cpp  ****  * 
   4:USB_MIDI.cpp  ****  *  This can be used with any 5-pin DIN or TRS connector that has been wired up
   5:USB_MIDI.cpp  ****  *  to one of the UART Rx pins on Daisy.
   6:USB_MIDI.cpp  ****  *  This will use D14 as the UART 1 Rx pin
   7:USB_MIDI.cpp  ****  * 
   8:USB_MIDI.cpp  ****  *  This example will also log incoming messages to the serial port for general MIDI troubleshootin
   9:USB_MIDI.cpp  ****  */
  10:USB_MIDI.cpp  **** #include "daisy_seed.h"
  11:USB_MIDI.cpp  **** 
  12:USB_MIDI.cpp  **** /** This prevents us from having to type "daisy::" in front of a lot of things. */
  13:USB_MIDI.cpp  **** using namespace daisy;
