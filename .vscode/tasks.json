{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "folderName",
            "type": "pickString",
            "description": "Select folder/project to build",
            "options": [
                "oscbank",
                "oscillator"
            ]
        }
    ],
    "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make clean; make",
      "options": {
        "cwd": "${workspaceFolder}/${input:folderName}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build_and_program",
      "type": "shell",
      "command": "make clean; make; make program",
      "options": {
        "cwd": "${workspaceFolder}/oscbank"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build_and_program_dfu",
      "type": "shell",
      "command": "make clean; make; make program-dfu",
      "options": {
        "cwd": "${workspaceFolder}/oscbank"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build_all",
      "type": "shell",
      "command": "make clean; make",
      "dependsOn": [
        "build_libdaisy",
        "build_daisysp"
      ],
      "options": {
        "cwd": "${workspaceFolder}/oscbank"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build_all_debug",
      "type": "shell",
      "command": "make clean; DEBUG=1 make",
      "dependsOn": [
        "build_libdaisy",
        "build_daisysp"
      ],
      "options": {
        "cwd": "${workspaceFolder}/oscbank"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "program",
      "type": "shell",
      "command": "make program",
      "options": {
        "cwd": "${workspaceFolder}/oscbank"
      }
    },
    {
      "label": "program-dfu",
      "type": "shell",
      "command": "make program-dfu",
      "options": {
        "cwd": "${workspaceFolder}/oscbank"
      }
    },
    {
      "label": "build_libdaisy",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/DaisyExamples/libDaisy"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build_daisysp",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/DaisyExamples/DaisySP"
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
